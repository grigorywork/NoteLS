<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:id="@+id/week_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/widget_bg" android:scaleType="fitXY" android:importantForAccessibility="no" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="8dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal">
            <TextView android:id="@+id/week_prev" android:layout_width="48dp" android:layout_height="48dp" android:gravity="center" android:text="@string/widget_previous_symbol" android:textSize="24sp" android:textColor="#FFFFFF" />
            <TextView android:id="@+id/week_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:gravity="center" android:maxLines="2" android:ellipsize="end" android:textSize="14sp" android:textStyle="bold" android:textColor="#FFFFFF" />
            <TextView android:id="@+id/week_next" android:layout_width="48dp" android:layout_height="48dp" android:gravity="center" android:text="@string/widget_next_symbol" android:textSize="24sp" android:textColor="#FFFFFF" />
            <TextView android:id="@+id/week_add" android:layout_width="48dp" android:layout_height="48dp" android:gravity="center" android:text="@string/widget_add_symbol" android:textSize="26sp" android:textColor="#FFFFFF" />
            <TextView android:id="@+id/week_menu" android:layout_width="48dp" android:layout_height="48dp" android:gravity="center" android:text="@string/widget_menu_symbol" android:textSize="22sp" android:textColor="#FFFFFF" />
        </LinearLayout>
        <TextView android:id="@+id/week_day_0" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:minHeight="48dp" android:gravity="center_vertical" android:paddingHorizontal="8dp" android:maxLines="2" android:ellipsize="end" android:textSize="14sp" android:textColor="#FFFFFF" />
        <TextView android:id="@+id/week_day_1" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:minHeight="48dp" android:gravity="center_vertical" android:paddingHorizontal="8dp" android:maxLines="2" android:ellipsize="end" android:textSize="14sp" android:textColor="#FFFFFF" />
        <TextView android:id="@+id/week_day_2" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:minHeight="48dp" android:gravity="center_vertical" android:paddingHorizontal="8dp" android:maxLines="2" android:ellipsize="end" android:textSize="14sp" android:textColor="#FFFFFF" />
        <TextView android:id="@+id/week_day_3" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:minHeight="48dp" android:gravity="center_vertical" android:paddingHorizontal="8dp" android:maxLines="2" android:ellipsize="end" android:textSize="14sp" android:textColor="#FFFFFF" />
        <TextView android:id="@+id/week_day_4" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:minHeight="48dp" android:gravity="center_vertical" android:paddingHorizontal="8dp" android:maxLines="2" android:ellipsize="end" android:textSize="14sp" android:textColor="#FFFFFF" />
        <TextView android:id="@+id/week_day_5" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:minHeight="48dp" android:gravity="center_vertical" android:paddingHorizontal="8dp" android:maxLines="2" android:ellipsize="end" android:textSize="14sp" android:textColor="#FFFFFF" />
        <TextView android:id="@+id/week_day_6" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:minHeight="48dp" android:gravity="center_vertical" android:paddingHorizontal="8dp" android:maxLines="2" android:ellipsize="end" android:textSize="14sp" android:textColor="#FFFFFF" />
    </LinearLayout>
</FrameLayout>
